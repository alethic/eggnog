; Gap 3: an undiscriminated anyOf, read as a join rather than a syntactic meet.
;
;   { "anyOf": [
;       { "required": ["legacyId"], "properties": { "status": { "enum": ["active", "archived"] } } },
;       { "required": ["id2"],      "properties": { "status": { "enum": ["draft", "active"] } } } ] }
;
;   WHERE status = 'purged'
;
; No branch pins a property to a const, so CosmosSchemaFacts.WalkBranches takes the meet: rule
; heads equal in every branch. OneOf {active, archived} and OneOf {draft, active} are different
; heads, so nothing about status survives and the query is sent as written.
;
; Here the anyOf becomes a hidden discriminator "$anyOf/0" over its branch indices. Each branch's
; facts are guarded on its index, the split runs over the schema itself, and the lift unions the
; branch domains: status is one of {active, archived, draft}. 'purged' is outside it.
;
; anyOf allows a document to satisfy both branches. The split is still sound: every document
; satisfies at least one, so the cases cover it.

(include "prelude.egg")

(present (Schema) "$anyOf/0")
(set (dom (Schema) "$anyOf/0") (set-of "0" "1"))
(discriminator "$anyOf/0" "0")
(discriminator "$anyOf/0" "1")

(rule ((present c "$anyOf/0") (= (dom c "$anyOf/0") (set-of "0")))
      ((present c "legacyId") (set (dom c "status") (set-of "active" "archived")))
      :ruleset horn)
(rule ((present c "$anyOf/0") (= (dom c "$anyOf/0") (set-of "1")))
      ((present c "id2") (set (dom c "status") (set-of "draft" "active")))
      :ruleset horn)

(let $q (StrEq "status" "purged"))
(where $q)

; Without the split the branches never meet anything.
(run-schedule (saturate horn lattice rewrite))
(fail (check (= (dom (Schema) "status") (set-of "active" "archived" "draft"))))
(fail (check (= $q (PFalse))))

; With it, the schema's own domain for status is the union of the branches'...
(run-schedule (saturate horn lattice split rewrite))
(check (= (dom (Schema) "status") (set-of "active" "archived" "draft")))

; ...and a value outside it contradicts the declaration.
(check (contradiction (Query)))
(check (= $q (PFalse)))

; What every branch requires is not lifted: legacyId and id2 are each one branch's.
(fail (check (present (Schema) "legacyId")))
(fail (check (present (Schema) "id2")))

(extract $q)

; A real container: sweep's "links" (sweep-app/src/Sweep.Cosmos.Data/Schemas/links.schema.json,
; with common.schema.json's uuid, instant and metadata), and the queries its facade probe asks
; (Sweep.Tests/Facade/Data/FacadeLinkPushdownLiveProbe.cs).
;
; Two levels of envelope: $.type is "Link" (declared only as a string), and $.data.type is the
; real discriminator, enum park | map | spot under a oneOf of const branches:
;   park: data.data.parkId uuid, required
;   map:  data.data.parkId, data.data.mapId uuid, both required
;   spot: data.data.location, required
; Everything in data is required, including data.type, data.offline (boolean) and data.metadata,
; whose createUtcTime / changeUtcTime are fixed-width instants (deleteUtcTime is one or null).

(include "prelude.egg")

; --- what the schema compiler would emit -----------------------------------------------------

(present (Schema) "type")
(set (types (Schema) "type") (set-of "string"))
(present (Schema) "linkId")
(set (types (Schema) "linkId") (set-of "number"))
(set (lo (Schema) "linkId") 1)
(set (hi (Schema) "linkId") 2147483647)

(present (Schema) "data.type")
(set (dom (Schema) "data.type") (set-of "park" "map" "spot"))
(discriminator "data.type" "park")
(discriminator "data.type" "map")
(discriminator "data.type" "spot")

(present (Schema) "data.guid")
(form (Schema) "data.guid" "uuid-lower")
(present (Schema) "data.label")
(set (types (Schema) "data.label") (set-of "string"))
(present (Schema) "data.offline")
(set (types (Schema) "data.offline") (set-of "boolean"))
(present (Schema) "data.metadata")
(form (Schema) "data.metadata.createUtcTime" "instant-ms")
(form (Schema) "data.metadata.changeUtcTime" "instant-ms")
(form (Schema) "data.metadata.deleteUtcTime" "instant-ms")

(rule ((present c "data.type") (= (dom c "data.type") (set-of "park")))
      ((present c "data.data.parkId") (form c "data.data.parkId" "uuid-lower"))
      :ruleset horn)
(rule ((present c "data.type") (= (dom c "data.type") (set-of "map")))
      ((present c "data.data.parkId") (form c "data.data.parkId" "uuid-lower")
       (present c "data.data.mapId") (form c "data.data.mapId" "uuid-lower"))
      :ruleset horn)
(rule ((present c "data.type") (= (dom c "data.type") (set-of "spot")))
      ((present c "data.data.location"))
      :ruleset horn)

; --- the probe's queries ---------------------------------------------------------------------

; "map": Links.Where(i => (i.Body as MapLinkBody)!.MapId == Map). Parity: one kind, lowered.
(push)
(let $q (And (StrEq "data.type" "map") (UuidEq "data.data.mapId" "22222222-2222-2222-2222-222222222222")))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= $q (And (StrEq "data.type" "map") (StrEq "data.data.mapId" "22222222-2222-2222-2222-222222222222"))))
(extract $q)
(pop)

; "park": park and map links of one park, written IN.
(push)
(let $q (And (Or (StrEq "data.type" "park") (StrEq "data.type" "map"))
             (UuidEq "data.data.parkId" "11111111-1111-1111-1111-111111111111")))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (form (Query) "data.data.parkId" "uuid-lower"))
(check (= $q (And (Or (StrEq "data.type" "park") (StrEq "data.type" "map"))
                  (StrEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))))
(extract $q)
(pop)

; "park" again, spelt per kind -- the shape that pushes only two IS_DEFINED tests today.
(push)
(let $q (Or (And (StrEq "data.type" "park") (UuidEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))
            (And (StrEq "data.type" "map") (UuidEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= (dom (Query) "data.type") (set-of "park" "map")))
(check (form (Query) "data.data.parkId" "uuid-lower"))
(check (= $q (Or (And (StrEq "data.type" "park") (StrEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))
                 (And (StrEq "data.type" "map") (StrEq "data.data.parkId" "11111111-1111-1111-1111-111111111111")))))
(extract $q)
(pop)

; "offline refresh": the same, AND i.Offline AND i.ChangeUtcTime > since. The instant range
; lowers on the declared fixed-width form; everything reaches the service.
(push)
(let $q (And (And (Or (StrEq "data.type" "park") (StrEq "data.type" "map"))
                  (UuidEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))
             (And (BoolTrue "data.offline")
                  (InstantGt "data.metadata.changeUtcTime" "2026-08-02T12:00:00.000Z"))))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= $q (And (And (Or (StrEq "data.type" "park") (StrEq "data.type" "map"))
                       (StrEq "data.data.parkId" "11111111-1111-1111-1111-111111111111"))
                  (And (BoolTrue "data.offline")
                       (StrGt "data.metadata.changeUtcTime" "2026-08-02T12:00:00.000Z")))))
(extract $q)
; How much the split cost on a real schema: Assume rows are the contexts it made.
(print-size Assume)
(print-size parent)
(print-size form)
(pop)

; The facade's own view filter (FacadeModel.cs): type = 'Link' AND data.type IN (park, map, spot).
; The IN list is the whole required enum, so the schema answers it and it is not asked. 'Link'
; is not declared -- type is only a string -- so that conjunct stays.
(push)
(let $q (And (StrEq "type" "Link")
             (Or (StrEq "data.type" "park") (Or (StrEq "data.type" "map") (StrEq "data.type" "spot")))))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= $q (StrEq "type" "Link")))
(extract $q)
(pop)

; A spot has no parkId, so a query that admits spots proves nothing about it.
(push)
(let $q (And (Not (StrEq "data.type" "map"))
             (UuidEq "data.data.parkId" "11111111-1111-1111-1111-111111111111")))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(fail (check (form (Query) "data.data.parkId" "uuid-lower")))
(extract $q)
(pop)

; Gap 4: a bound, which the adapter's claim model has no room for (TODO.md, "The keywords still
; not read": "no claim in the model is about an interval").
;
;   { "properties": { "n": { "type": "integer", "minimum": 0, "maximum": 100 } } }
;
;   WHERE n > 500
;
; Here a bound is two more lattice-valued functions with min and max as their merges, and one
; contradiction rule. Nothing else changes.

(include "prelude.egg")

(set (types (Schema) "n") (set-of "number"))
(set (lo (Schema) "n") 0)
(set (hi (Schema) "n") 100)

(push)
(let $q (NumGt "n" 500))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (contradiction (Query)))
(check (= $q (PFalse)))
(extract $q)
(pop)

; A bound inside the range contradicts nothing, and the predicate is left alone.
(push)
(let $q (NumGt "n" 50))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(fail (check (contradiction (Query))))
(check (= (lo (Query) "n") 51))
(extract $q)
(pop)

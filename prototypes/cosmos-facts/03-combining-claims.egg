; Gap 2: two claims about one path that only together prove a guard.
;
;   { "type": "object", "required": ["kind"],
;     "properties": { "kind": { "enum": ["order", "invoice"] } },
;     "if":   { "properties": { "kind": { "const": "order" } } },
;     "then": { "properties": { "ref": { <canonical lowercase uuid> } } } }
;
;   WHERE kind <> 'invoice' AND CAST(ref AS UUID) = UUID'123e...'
;
; The schema gives OneOf(kind, {order, invoice}); the query gives NotEqualTo(kind, invoice).
; CosmosFact.Knows asks whether *one* known fact entails the guard EqualTo(kind, order), and
; neither does. A domain lattice narrows {order, invoice} by the disequality to {order}.

(include "prelude.egg")

(present (Schema) "kind")
(set (dom (Schema) "kind") (set-of "order" "invoice"))

(rule ((present c "kind") (= (dom c "kind") (set-of "order"))) ((form c "ref" "uuid-lower")) :ruleset horn)

(let $q (And (Not (StrEq "kind" "invoice"))
             (UuidEq "ref" "123e4567-e89b-12d3-a456-426614174000")))
(where $q)

; Horn alone: the guard never fires.
(run-schedule (saturate horn rewrite))
(fail (check (form (Query) "ref" "uuid-lower")))

; With the lattice: the domain narrows to {order}, the guard fires, the comparison lowers.
(run-schedule (saturate horn lattice rewrite))
(check (= (dom (Query) "kind") (set-of "order")))
(check (form (Query) "ref" "uuid-lower"))
(check (= $q (And (Not (StrEq "kind" "invoice"))
                  (StrEq "ref" "123e4567-e89b-12d3-a456-426614174000"))))
(extract $q)

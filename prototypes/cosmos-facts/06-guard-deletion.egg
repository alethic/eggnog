; Parity: guard deletion and tautologies, as rewrites plus extraction instead of rewriter code.
;
; The adapter weakens an ordering comparison it cannot prove exact to
;   IS_DEFINED(p) AND (NOT IS_STRING(p) OR p >= v)
; and deletes each guard a declared fact makes redundant (DESIGN.md, "A guard exists to admit what
; a fact would have excluded"). Here each deletion is one rewrite; extraction picks the result.

(include "prelude.egg")

; ADeclaredTypeMakesAnOrderingComparisonExactRatherThanWeakened:
;   { "properties": { "at": { "type": "string", "pattern": "<fixed ISO-8601 UTC>" } } }
(push)
(set (types (Schema) "at") (set-of "string"))
(let $q (And (IsDefined "at") (Or (Not (IsString "at")) (StrGe "at" "2024-01-01T00:00:00Z"))))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= $q (StrGe "at" "2024-01-01T00:00:00Z")))
(extract $q)
(pop)

; WithoutADeclaredTypeAnOrderingComparisonIsStillWeakened.
(push)
(let $q (And (IsDefined "at") (Or (Not (IsString "at")) (StrGe "at" "2024-01-01T00:00:00Z"))))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(fail (check (= $q (StrGe "at" "2024-01-01T00:00:00Z"))))
(extract $q)
(pop)

; ADeclaredTautologyIsNotAsked: kind is required and const "A", so kind = 'A' asks nothing.
(push)
(present (Schema) "kind")
(set (dom (Schema) "kind") (set-of "A"))
(let $q (And (StrEq "kind" "A") (StrEq "id" "x")))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(check (= $q (StrEq "id" "x")))
(extract $q)
(pop)

; WithoutAPresenceClaimTheComparisonStays: const without required admits a document with no
; kind, which kind = 'A' drops. The query's own conjunct proves presence in (Query), and that must
; not be what deletes it -- which is why tautologies are judged in (Schema).
(push)
(set (dom (Schema) "kind") (set-of "A"))
(let $q (And (StrEq "kind" "A") (StrEq "id" "x")))
(where $q)
(run-schedule (saturate horn lattice split rewrite))
(fail (check (= $q (StrEq "id" "x"))))
(extract $q)
(pop)

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Description>Equality saturation for .NET with egglog's capabilities and a typed C# API: relations, functions with lattice merges, constructors, rules, schedules, queries and extraction, plus scopes (child contexts, frozen bases shared across threads) and case splits with lift, on a C# reimplementation of egglog's engine.</Description>
        <PackageTags>egraph;e-graph;equality-saturation;egglog;datalog;rewriting;term-rewriting;union-find;free-join</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <!-- The library is trimming and NativeAOT compatible: IsAotCompatible turns on the trimming, single-file and AOT
         analyzers, and Analyzers.globalconfig makes every warning they report (IL2xxx, IL3xxx) an error. -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <GlobalAnalyzerConfigFiles Include="Analyzers.globalconfig" />
    </ItemGroup>

    <!-- The package page's readme is this project's README.md (absolute links only: nuget.org cannot resolve relative
         ones); the repository's README.md is the GitHub page. LICENSE and NOTICE travel with the package, since NOTICE
         carries egglog's MIT notice. The pack runs in the outer, cross-targeting build, which has no default items, so
         README.md is included explicitly (and removed from the inner builds' defaults first, to keep one item). -->
    <ItemGroup>
        <None Remove="README.md" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Eggnog.Tests" />
        <InternalsVisibleTo Include="Eggnog.Benchmarks" />
    </ItemGroup>

</Project>

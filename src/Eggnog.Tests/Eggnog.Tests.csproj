<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <!-- xUnit1051 asks every call with an optional CancellationToken (Scope.Run) to pass the test's token; the tests
             that exercise cancellation pass their own, and the rest run to completion. xUnit1031 flags blocking waits on
             tasks; the concurrency and thread-domain tests of both the engine (Relations/) and the library block on the
             tasks they race, on purpose, because the calls under test must stay on the test's thread. -->
        <NoWarn>$(NoWarn);CS1591;xUnit1051;xUnit1031</NoWarn>
        <!-- xunit.v3 builds the assembly as its own runner, and writes the entry point itself. -->
        <OutputType>Exe</OutputType>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Eggnog\Eggnog.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The benchmark app's comparison mode does not depend on BenchmarkDotNet; its sources are compiled into the tests
             too, so Benchmarks/ can test its parsing, arithmetic and outcome rules. The same goes for the writes
             benchmarks' shard counts, and for the allocation probe's invoker, which needs only BenchmarkDotNet's
             attributes. -->
        <Compile Include="..\Eggnog.Benchmarks\Comparison\*.cs" Link="Benchmarks\Comparison\%(Filename)%(Extension)" />
        <Compile Include="..\Eggnog.Benchmarks\Relations\Writes\WritesShardCounts.cs" Link="Benchmarks\Writes\WritesShardCounts.cs" />
        <Compile Include="..\Eggnog.Benchmarks\Probes\BenchmarkInvoker.cs" Link="Benchmarks\Probes\BenchmarkInvoker.cs" />
        <PackageReference Include="BenchmarkDotNet.Annotations" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <!-- The library's public surface, which Surface/PublicSurfaceTests compares with the built assembly. -->
        <EmbeddedResource Include="Surface\PublicSurface.txt" LogicalName="Eggnog.Tests.Surface.PublicSurface.txt" />
    </ItemGroup>

</Project>
